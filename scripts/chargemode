#!/bin/bash
set -eu
VERSION=1.0.0
[ "${1:-}" != version ] || { echo "chargemode $VERSION"; exit 0; }
[ "$EUID" -eq 0 ] || exec sudo "$0" "$@"
f=$(ls /sys/class/power_supply/BAT*/charge_types 2>/dev/null | head -n1)
[ -n "$f" ] || { echo "no charge_types node" >&2; exit 1; }
case "${1:-}" in
    gaming)   v=Long_Life ;;
    standard) v=Standard ;;
    fast)     v=Fast ;;
    evening)  grep -q '\[Fast\]' "$f" && v=Standard || exit 0 ;;
    status)   cat "$f"; exit 0 ;;
    *) echo "usage: chargemode gaming|standard|fast|evening|status|version" >&2; exit 2 ;;
esac
echo "$v" > "$f"
